[[keys]]
  index = 0
  [keys.widget]
    id = "button"
    [keys.widget.config]
      icon = "assets/common/back.png"
  [keys.action]
    deck = "main.deck"

[[keys]]
  index = 1
  [keys.widget]
    id = "button"
    [keys.widget.config]
      icon = "assets/screens/1.png"
  [keys.action]
    exec = "/home/thomas/.config/deckmaster/scripts/echoto.sh /home/thomas/.config/deckmaster/scripts/data/selectedscreen 1"

